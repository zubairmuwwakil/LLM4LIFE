# Copy to .env locally and fill with real values.
# Never commit .env or actual credentials.

# Identity roles
PRIMARY_PERSONAL_EMAIL=
SECONDARY_PERSONAL_EMAIL=
AI_AGENT_EMAIL=

# LLM4LIFE durable machine-state backend
DATABASE_URL=

# Google Tasks projection Worker (store production values as Cloudflare secrets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
SYNC_ADMIN_TOKEN=

# Optional trusted local Obsidian bridge/runtime configuration
OBSIDIAN_VAULT_PATH=
OBSIDIAN_VAULT_SCOPE=primary-vault
# Generate a random token locally; use at least 32 characters. Never commit the real value.
OBSIDIAN_BRIDGE_TOKEN=
OBSIDIAN_BRIDGE_PORT=8765
# macOS uses ':' between multiple prefixes. Keep this as narrow as practical.
OBSIDIAN_ALLOWED_PREFIXES=
# Whole-vault access is opt-in and not recommended when narrower prefixes work.
OBSIDIAN_BRIDGE_ALLOW_WHOLE_VAULT=false
OBSIDIAN_BRIDGE_AUDIT_PATH=.private/obsidian-bridge/audit.jsonl

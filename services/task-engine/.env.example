# Local development defaults. Do not commit real secrets.
TASK_ENGINE_DATABASE_URL=postgresql+psycopg://task_engine:change-me@db:5432/task_engine
TASK_ENGINE_TIMEZONE=America/Toronto
TASK_ENGINE_FOLLOWUP_DELAY_MINUTES=60
TASK_ENGINE_MISSES_BEFORE_REVIEW=3
TASK_ENGINE_AUTO_RESCHEDULE_HORIZON_DAYS=7
TASK_ENGINE_MOVABLE_WINDOW_START_HOUR=13
TASK_ENGINE_MOVABLE_WINDOW_END_HOUR=21
TASK_ENGINE_HIGH_STAKES_THRESHOLD=70
# Set in production and send as: Authorization: Bearer <token>
TASK_ENGINE_API_TOKEN=

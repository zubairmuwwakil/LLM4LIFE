# Local development defaults. Do not commit real secrets.
TASK_ENGINE_DATABASE_URL=postgresql+psycopg://task_engine:change-me@db:5432/task_engine
TASK_ENGINE_TIMEZONE=America/Toronto
TASK_ENGINE_FOLLOWUP_DELAY_MINUTES=60
TASK_ENGINE_MISSES_BEFORE_REVIEW=3
TASK_ENGINE_AUTO_RESCHEDULE_HORIZON_DAYS=7
TASK_ENGINE_MOVABLE_WINDOW_START_HOUR=13
TASK_ENGINE_MOVABLE_WINDOW_END_HOUR=21
TASK_ENGINE_HIGH_STAKES_THRESHOLD=70
# Set in production and send as: Authorization: Bearer <token>
TASK_ENGINE_API_TOKEN=

# Deterministic command worker. Use a least-privilege Neon role that can read the
# approved llm4life views and EXECUTE only guarded functions used by the worker.
TASK_ENGINE_CANONICAL_DATABASE_URL=

# Google refresh token must include Calendar scope. Reusing a Tasks-only refresh
# token will fail closed with an authorization error.
TASK_ENGINE_GOOGLE_CLIENT_ID=
TASK_ENGINE_GOOGLE_CLIENT_SECRET=
TASK_ENGINE_GOOGLE_REFRESH_TOKEN=
TASK_ENGINE_GOOGLE_CALENDAR_API_BASE=https://www.googleapis.com/calendar/v3
TASK_ENGINE_GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token

TASK_ENGINE_WORKER_LEASE_SECONDS=120
TASK_ENGINE_WORKER_MAX_ATTEMPTS=8
TASK_ENGINE_WORKER_RETRY_BASE_SECONDS=15
TASK_ENGINE_WORKER_RETRY_MAX_SECONDS=1800
